{
  "name": "vibecode-wrapped",
  "version": "0.1.0",
  "description": "Your year with AI coding agents, wrapped. Spotify Wrapped-style recap for Claude Code and Codex. 100% local.",
  "type": "module",
  "bin": {
    "vibecode-wrapped": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/copy-ui.mjs",
    "dev": "tsc -p . --watch",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude-code",
    "codex",
    "wrapped",
    "ai-agents",
    "cli",
    "stats",
    "year-in-review"
  ],
  "license": "MIT",
  "author": "BerkanAtik",
  "repository": { "type": "git", "url": "git+https://github.com/BerkanAtik/vibecode-wrapped.git" },
  "homepage": "https://github.com/BerkanAtik/vibecode-wrapped#readme",
  "bugs": "https://github.com/BerkanAtik/vibecode-wrapped/issues",
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
